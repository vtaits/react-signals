{
  "type": "module",
  "name": "@vtaits/react-signals",
  "version": "1.0.2",
  "description": "React integration for TC39 signals",
  "files": [
    "dist",
    "src",
    "!src/stories",
    "!src/**/*.test.js"
  ],
  "main": "./src/index.js",
  "module": "./src/index.js",
  "typings": "dist/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:ts": "tsc",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "test:storybook": "vitest --project=storybook run",
    "test:storybook:dev": "vitest --project=storybook --watch",
    "test": "npm run lint && npm run test:ts && npm run test:storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vtaits/react-signals.git"
  },
  "keywords": [
    "react",
    "signals",
    "signal",
    "proposal",
    "signal-polyfill"
  ],
  "author": "Vadim Taits <taizvadim@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vtaits/react-signals/issues"
  },
  "homepage": "https://github.com/vtaits/react-signals#readme",
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "signal-polyfill": "^0.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "playwright": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "signal-polyfill": "^0.2.2",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
